{
  "include": [
    "src/env.d.ts",
    "src/**/*",
    "../preload/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [ "./src/*" ],
      "@InvAmount/*": [ "src/renderer/src/router/inventory/InventoryAmount/*" ],
      "@Inventory/*": [ "src/renderer/src/router/inventory/*" ]
    }
  }
}

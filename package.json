{
  "name": "zaiko-kanri",
  "productName": "オーシャン",
  "version": "1.0.0",
  "description": "An Electron application with Vue and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "type": "module",
  "build": {
    "appId": "com.OCEANS7A-DEV.Oceanstockman",
    "productName": "オーシャン",
    "files": [
      "dist",
      "out/main",
      "out/preload",
      "out/renderer"
    ],
    "extraResources": [
      {
        "from": "vendor/qpdf",
        "to": "qpdf",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "qpdf/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OCEANS7A-DEV",
        "repo": "electron-app",
        "private": false
      }
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:node": "tsc -p tsconfig.node.json",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run build:node && electron-vite build",
    "postinstall": "electron-builder install-app-deps && electron-rebuild",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "release": "electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@mui/x-data-grid": "^8.0.0",
    "@mui/x-date-pickers": "^8.5.0",
    "@types/react": "^19.1.6",
    "better-sqlite3": "^12.2.0",
    "dayjs": "^1.11.13",
    "electron-log": "^5.4.0",
    "electron-prompt": "^1.7.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "exceljs": "^4.4.0",
    "googleapis": "^150.0.1",
    "iconv-lite": "^0.7.0",
    "jaconv": "^1.0.4",
    "jposta": "^0.4.1",
    "keytar": "^7.9.0",
    "mui": "^0.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-merger-js": "^5.1.2",
    "pdf-table-extractor": "^1.0.3",
    "puppeteer-core": "^24.10.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.1",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.9.6",
    "react-select": "^5.10.1",
    "react-spinners": "^0.17.0",
    "react-sweetalert2": "^0.6.0",
    "react-virtualized": "^9.22.6",
    "react-window": "^1.8.11",
    "recharts": "^3.1.0",
    "router": "^2.2.0",
    "sweetalert2": "^11.19.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/electron-store": "^1.3.1",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "electron-publish": "^26.0.11",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^3.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vue": "^3.5.13",
    "vue-eslint-parser": "^10.1.3",
    "vue-tsc": "^2.2.8"
  }
}

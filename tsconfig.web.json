{
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/renderer/src/index.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [ "src/renderer/src/*" ],
      "@InvAmount/*": [ "src/renderer/src/router/inventory/InventoryAmount/*" ],
      "types": [ "node", "better-sqlite3" ]
    }
  }
}

{
  // "extends" を削除し、Web/React用の設定をすべて書き込みます
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue", // .tsx ファイルも自動的に含まれます
    "src/preload/*.d.ts",
    "src/renderer/src/index.tsx"
  ],
  "compilerOptions": {
    "composite": true,

    // ▼▼ Web/React 用の基本設定を追加 ▼▼
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "jsx": "react-jsx", // React 17以降のJSXトランスフォーム
    "strict": true,
    "skipLibCheck": true,
    // ▲▲ ここまで ▲▲

    // ▼▼ エラー解消のための設定（既存の設定を再確認） ▼▼
    "module": "ESNext",
    "moduleResolution": "bundler", // "nodenext" ではなく "bundler" が Vite では標準
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [ "src/renderer/src/*" ],
      "@InvAmount/*": [ "src/renderer/src/router/inventory/InventoryAmount/*" ]
    }
  }
}

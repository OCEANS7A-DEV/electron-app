}

table.cell_p05 th,
table.cell_p05 td {
	padding: .5em;
}

table.first_td_center tr td:first-child {
	text-align: center;
}

table.faq {
	border-collapse: separate;
	padding-right: .2em;
}
table.faq th,
table.faq td {
	line-height: 1.8em;
}
table.faq th {
	width: 3em;
}
table.faq td {
	font-weight: bold;
}


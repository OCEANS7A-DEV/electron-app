	// オンライン自主応募の受付
	function oNLineJiSyuOuboRadioBtn() {
		// 新規学卒者等の場合
		if ($("input:radio[name='kBN1RadioBtn']:checked").val() == '2') {
			// 高卒の場合
			if ($('input[name=kBN1SHSIRadioBtn]:eq(1)').prop('checked')) {
				// オンライン自主応募の受付ラジオボタンを非活性状態にする。
				disabledONLineJiSyuOuboRadioBtn();
				// オンライン自主応募に関する注意文同意チェックボックスを非活性状態にする。
				disabledOuboTyuiCKBox();

				// 高卒以外の場合
			} else {
				// オンライン自主応募の受付ラジオボタンを活性状態にする。
				activateONLineJiSyuOuboRadioBtn();

				// オンライン自主応募を受け付けるラジオボタンが選択されている場合
				if ($("input:radio[name='oNLineJiSyuOuboRadioBtn']:checked").val() =='1') {
					// オンライン自主応募に関する注意文同意チェックボックスを活性状態にする。

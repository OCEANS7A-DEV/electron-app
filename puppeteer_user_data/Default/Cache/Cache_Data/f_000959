//特別に支払われる手当 追加削除
$(function(){
	// 入力欄を追加ボタンが押された時のアクション
	$("table").on('click','[name^="tKBSTATadd"]' ,function() {
		var id = tKBSTATCount();
		
		if(id < 4){
			
			// 特別に支払われる手当
			var tKBSTATnum = $('#ID_tKBSTATnum').val();
			tKBSTATnum = parseInt(tKBSTATnum) + 1;
			$('#ID_tKBSTATnum').val(tKBSTATnum);
			
			// tKBSTATAdd()呼び出し
			tKBSTATAdd(id);
			
		}
		sessionKeep();
	});

	// 入力欄を削除ボタンが押された時のアクション
	$("table").on('click','[name^="tKBSTATdel"]' ,function() {
		var id = tKBSTATCount();
		
		if(id > 1){
			
			// 特別に支払われる手当
			var tKBSTATnum = $('#ID_tKBSTATnum').val();
			tKBSTATnum = parseInt(tKBSTATnum) - 1;
			$('#ID_tKBSTATnum').val(tKBSTATnum);

			var target = $(this).attr('id').lastIndexOf('_', $(this).attr('id').length);
			
			// tKBSTATDel()呼び出し
			tKBSTATDel(parseInt($(this).attr('id').substr(target + 1, 2)));
			
		}
		sessionKeep();
	});
});


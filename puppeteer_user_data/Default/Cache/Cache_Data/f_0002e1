//画面からチェックした求人保持リスト取得
function getCheckedKjList(Obj) {

	if (Obj == undefined) {
		return new Array();
	}

	let chkListStr = "";
	if (typeof Obj === "string") {
		chkListStr = Obj;
	} else {
		chkListStr = Obj.val();
	}

	if (chkListStr == null
		|| chkListStr == undefined
		|| chkListStr == "") {
		return new Array();
	} else {
		return chkListStr.replace(/\[|\]/g,'').split(',').filter(item => item != "" && item != null);
	}
}

// チェックした求人保持リスト制限処理
function setChkListLimit(arr) {

	let chkList = arr;

	if (chkList == undefined || !Array.isArray(chkList)) {
		return new Array();
	}

	const MAX = 50;
	const len = chkList.length;
	if (len > MAX) {
		const deleteIdx = Math.abs(len - MAX);
		chkList = chkList.splice(deleteIdx, len);
	}

	return chkList;
}

// セッションにお気に入り保持リストを保存
function saveSessionRequest(screenId, kjDetaliListStr, checkboxFlg, chkListHddnObj, allSelectObj, ckBoxesObj, floatBtnAraObj) {

	// セッションチェックした求人情報リストを更新
	$.ajax({
		url: screenId +'SaveSession.do',
		type: 'POST',
		datatype: 'json',
		data: {
			screenId: screenId,
			action: "saveSession",
			checkedKjDetailList : kjDetaliListStr.toString(),
			kjCheckedFlag : checkboxFlg
		}
	}).done(function(data){
		const shoriCode = data.shoriCode;
		if (shoriCode == "0") {
			let chkResult = getCheckedKjList(data.sessionCheckedKjList);

			// 画面表示設定
			setDisplay(chkResult, chkListHddnObj, allSelectObj, ckBoxesObj, floatBtnAraObj);
		}
	}).fail(function(data){
		let pathArr = data.responseText.split('/');
		let errScreenId = "";
		for (let item of pathArr) {
		    if (item.includes(".jsp")) {
		        errScreenId = item.replace(".jsp", "");
		    }
		}
		window.location.replace("./" + screenId + ".do?screenId=" + errScreenId);
	});
}

// 画面表示設定
function setDisplay(sessionKjList, chkListHddnObj, allSelectObj, ckBoxesObj, floatBtnAraObj) {

	// 一般チェックフラグ
	var ipCkFlg = false;
	// 学卒チェックフラグ
	var gsCkFlg = false;



	// チェックの状態を更新する。
	for (var obj of ckBoxesObj) {
		var ckBoxVal = obj.value;
		const index = sessionKjList.indexOf(ckBoxVal);
		if (0 <= index) {
			obj.checked = true;

			// チェック求人の学卒有無も判断
			if (ckBoxVal.slice(-1) == '8') {
				gsCkFlg = true;

			} else {
				ipCkFlg = true;
			}
		} else {
			obj.checked = false;
		}
	}
	// セッションで持っている求人。
	for (var i = 0; i < sessionKjList.length; i++) {
		// チェック求人の学卒有無も判断
		if (sessionKjList[i].slice(-1) == '8') {
			gsCkFlg = true;

		} else {
			ipCkFlg = true;
		}
	}
	// チェック状況に合わせて、チェックした求人の求人票を表示ボタンの表示切替
	$('[id="ID_checkedKyujinhyoIppanBtn"]').toggle(ipCkFlg);
	$('[id="ID_checkedKyujinhyoDsBtn"]').toggle(gsCkFlg);

	if(ipCkFlg && gsCkFlg) {
		$('.checkedKyujinhyoBtnDs_1').css('display','none');
		$('.checkedKyujinhyoBtnIppan_1').css('display','none');
	} else if (!ipCkFlg && gsCkFlg)  {
		$('.checkedKyujinhyoBtnDs_2').css('display','none');
	} else if (ipCkFlg && !gsCkFlg)  {
		$('.checkedKyujinhyoBtnIppan_2').css('display','none');
	} else {
		$('.checkedKyujinhyoBtnDs_1').css('display','none');
		$('.checkedKyujinhyoBtnIppan_1').css('display','none');
		$('.checkedKyujinhyoBtnDs_2').css('display','none');
		$('.checkedKyujinhyoBtnIppan_2').css('display','none');
	}


	// 画面チェックした求人保持リストを入れ替える
	if (sessionKjList.length <= 0) {
		chkListHddnObj.attr('value', null);
		floatBtnAraObj.hide();
	} else {
		chkListHddnObj.attr('value', sessionKjList.toString());
		floatBtnAraObj.show();
	}

	if (ckBoxesObj.length > 0) {
		var ckBoxes = ckBoxesObj;
		// チェックボックスの活性、非活性化
		const isDisable = (sessionKjList.length >= 50);
		for (var obj of ckBoxes) {
			if (!obj.checked) {
				obj.disabled = isDisable;
			}
		}

		// 全て選択ボタン名を変更
		const diabledCnt = ckBoxes.filter((idx, item) => item.disabled).length;
		if (diabledCnt == ckBoxes.length) {
			allSelectObj.children().eq(0)[0].innerText ='全て選択';
			allSelectObj.children().eq(1)[0].innerText ='全て選択';
			allSelectObj.eq(0).prop('disabled', true);
			allSelectObj.eq(1).prop('disabled', true);
		} else {
			const stateChgCnt = ckBoxes.filter((idx, item) => item.checked || item.disabled).length;
			if (stateChgCnt == ckBoxes.length) {
				allSelectObj.children().eq(0)[0].innerText ='全て解除';
				allSelectObj.children().eq(1)[0].innerText ='全て解除';
			} else {
				allSelectObj.children().eq(0)[0].innerText ='全て選択';
				allSelectObj.children().eq(1)[0].innerText ='全て選択';
			}
		}
	}
}

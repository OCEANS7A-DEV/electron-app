//PRロゴモーダル内でロゴマーク選択時、選択値保存処理
function savePrBtn(){

	//モーダル内のPRロゴを全取得
	var map = $('.modal_content input[name="modalTmpChkPRLogo"]').map(function(){
		return $(this);
	}).get();
	//PRロゴ用の項目
	var label ="";
	//空白
	var spase="　";

	//繰り返し、PRロゴチェックボックスを１つずつ確認
	for(let i = 0; i < map.length; i++){

		//PRロゴチェックボックスの要素を取得
		var checkBox = $('.prDailog .prLogoInModal input[name="chkPRLogo"][value="'+ map[i].val() +'"]');
		//ID取得
		var id = checkBox.attr('id');
		//Value値取得
		var value = checkBox.val();

		//チェックが入っていた場合
		if($(map[i]).is(':checked')){
			//非表示状態のモーダル内のチェックボックスを選択状態にする
			$(checkBox).before('<input type="checkbox" id="'+ id +'" name="chkPRLogo" value="'+value+'" checked>');
			//もとにあったものを削除
			$(checkBox).remove();
			//PRロゴラベルを追記
			label = label + spase + $('#ID_LchkPRLogo' + value).text();
		//チェックが入っていない場合
		}else{
			//非表示状態のモーダル内のチェックボックスを非選択状態にする
			$(checkBox).before('<input type="checkbox" id="'+ id +'" name="chkPRLogo" value="'+value+'">');
			//もとにあったものを削除
			$(checkBox).remove();
		}
	}
	//先頭の空白除去
	label = label.trim();

	//モーダル内でチェックされた項目を取得
	var checked = $('.prDailog .prLogoInModal input[name="chkPRLogo"]:checked').map(function(){
		return $(this).val();
	}).get();
	//モーダル内項目が選択されている場合
	if(checked.length > 0){
		//モーダル表示ボタン選択状態にする
		$('#ID_prLogoBtn').addClass('selected');
		//選択中表示
		$('.prLogoArea').css('display','flex');
		$('.prLogoArea').css('align-items','center');
		//PRロゴマークラベルを表示
		$('#ID_prLogoLabel').html(label);
	//モーダル内項目が１つも選択されていない場合
	}else{
		//モーダル表示ボタン非選択状態にする
		$('#ID_prLogoBtn').removeClass('selected');
		clearPRlogo()
	}

	// modalClose
	modalClose(true);
}


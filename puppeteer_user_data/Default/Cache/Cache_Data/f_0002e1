	//PRロゴ用の項目
	var label ="";
	//空白
	var spase="　";

	//繰り返し、PRロゴチェックボックスを１つずつ確認
	for(let i = 0; i < checkedValue.length; i++){

		//PRロゴチェックボックスの要素を取得
		var checkBox = $('.prDailog .prLogoInModal input[name="chkPRLogo"][value="'+ checkedValue[i] +'"]');

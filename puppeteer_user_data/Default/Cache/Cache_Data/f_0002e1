//押下されたチェックボックスを元に対象となるモーダルを開く
$('.modalAction').change(function(){
	// modalActionのCheckBoxは押下のみで変更しない
	$(this).prop('checked', !$(this).prop('checked'));

	//条件を選ぶの場合
	if($(this).attr('name') === 'daiJyoukenBox'){
		//モーダル部品取得
		var targetHtml = $('.modalJyoukenBox' + $(this).val()).html();
		// ターゲットHTMLのチェックボックス名書き換え
		targetHtml = targetHtml.replace(/jyoukenBox/g, 'modalTmpJyoukenBox');

	//特集求人の場合
	} else if ($(this).attr('name') === 'daiTokusyuBox'){
		//モーダル部品取得
		var targetHtml = $('.modalTokusyuKyujinBox' + $(this).val()).html();
		// ターゲットHTMLのチェックボックス名書き換え
		targetHtml = targetHtml.replace(/tokusyuBox/g, 'modalTmpTokusyuBox').replace(/type="checkbox"/g,'type="radio"');

	//かんたん職種の場合
	} else if($(this).attr('name') === 'daiEasyShokusyuBox'){
		//モーダル部品取得
		var targetHtml = $('.modalEasyShokusyuBox' + $(this).val()).html();
		// ターゲットHTMLのチェックボックス名書き換え
		targetHtml = targetHtml.replace(/easyShokusyuBox/g, 'modalTmpEasyShokusyuBox');
	}

	// モーダルダイアログをポップアップ表示
	modalDisp(targetHtml, true);

	//条件を選ぶ・特集求人・かんたん職種用のクラスを追加
	$('.modal_content').addClass('modalB_width');

	// 特集求人モーダル画面_ラジオボタン選択制御
	if($('.modalTokusyuKyujinBox' + $(this).val() + ' input[name="tokusyuBox"]:checked').length == 0) {
		$("input[name^='modalTmpTokusyuBox']").prop('checked', false);
	}

	// 職種モーダル画面_チェックボックス表示制御
	if($('.middle input[name=modalTmpEasyShokusyuBox]:checked').length >= 5) {
		$('.modal_content input[name=modalTmpEasyShokusyuBox]').not(':checked').prop('disabled',true);
	}
});


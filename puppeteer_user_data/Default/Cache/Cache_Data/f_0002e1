	let kjDetaliList = ckBoxesDetailObj.map(function(index, element){
		return element.value;
	}).get();
	let kjDetaliListStr = kjDetaliList.join(",");

	// 押下したボタンが全て選択ボタンならtrue、そうでなければfalseを設定
	let label = obj.innerText.trim();
	const checkboxFlg = (label == "全て選択");

	let allSelectObj = $('[name="checkBoxAllSelect"]');
	// フロントボタンエリア
	let floatBtnAraObj = null;
	if ($('[id="ID_float_search_button_area2"]').length <= 0) {
		floatBtnAraObj = $('[id="ID_float_search_button_area"]');
	} else {
		floatBtnAraObj = $('[id="ID_float_search_button_area2"]');
	}
	// 画面ID
	const screenId = $('input[type="hidden"][name="screenId"]').val();

	// セッションに保存
	saveSessionRequest(screenId, kjDetaliListStr, checkboxFlg, chkListHddnObj, allSelectObj, ckBoxesObj, floatBtnAraObj);

	// submit防止
	return false;
}


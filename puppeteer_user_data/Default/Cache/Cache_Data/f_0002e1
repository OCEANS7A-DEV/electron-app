//かんたん条件　階層２選択時の処理
function saveJyoukenModal(kaisou1){

	//モーダル内全項目（階層２）取得
	var map = $('.modal_content input[name="modalTmpJyoukenBox"]').map(function(){
		return $(this);
	}).get();

	for(let i = 0; i < map.length; i++){
		//チェックされている場合
		if($(map[i]).is(':checked')){
			//非表示中のモーダル部品を取得
			var checkBox = $('.r08ThAcWrapper .modalJyoukenBoxMiddle'+ kaisou1 +' input[name="jyoukenBox"][value="'+ map[i].val() +'"]');
			//ID取得（階層１番号）
			var id = checkBox.attr('id');
			//value取得（階層２番号）
			var value = checkBox.val();
			//非表示中のモーダル部品をチェック有りに更新（値保持のため）
			$(checkBox).before('<input type="checkbox" id="'+ id +'" name="jyoukenBox" value="'+value+'" checked>');
			//更新前のモーダル部品を削除
			$(checkBox).remove();
		}else{
			var checkBox = $('.r08ThAcWrapper .modalJyoukenBoxMiddle'+ kaisou1 +' input[name="jyoukenBox"][value="'+ map[i].val() +'"]');
			var id = checkBox.attr('id');
			var value = checkBox.val();
			//非表示中のモーダル部品をチェックなしに更新（値保持のため）
			$(checkBox).before('<input type="checkbox" id="'+ id +'" name="jyoukenBox" value="'+value+'">');
			$(checkBox).remove();
		}
	}

	//モーダル内でチェックされた項目を取得
	var checked = $('.r08ThAcWrapper .modalJyoukenBoxMiddle'+ kaisou1 +' input[name="jyoukenBox"]:checked').map(function(){
		return $(this).val();
	}).get();
	//モーダル内項目（階層２）が選択されている場合
	if(checked.length > 0){
		//親にあたる階層１ボタンを選択状態にする
		$('.jyoukenKNo' + kaisou1).prop('checked', true);
		$('.jyoukenKNo' + kaisou1).closest('label').addClass('buttonStyleChecked');
		//モーダル内項目（階層２）が１つも選択されていない場合
	}else{
		//親にあたる階層１ボタンを非選択状態にする
		$('.jyoukenKNo' + kaisou1).prop('checked', false);
		$('.jyoukenKNo' + kaisou1).closest('label').removeClass('buttonStyleChecked');
	}

	// modalClose
	modalClose(true);
}


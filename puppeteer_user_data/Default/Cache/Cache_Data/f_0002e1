function easyShokusyuCheck(){
	//チェック数取得
	var checked = $('.r08ThAcWrapper .easyShokusyu_style:checked').map(function(){
		return $(this).val();
	}).get();

	if(checked.length >= 3){
		$('.easyShokusyu_style').not(':checked').prop('disabled',true);
		$('.easyShokusyu_style').not(':checked').closest('label').addClass('buttonStyleDisabled');
	}else{
		$('.easyShokusyu_style').prop('disabled',false);
		$('.easyShokusyu_style').not(':checked').closest('label').removeClass('buttonStyleDisabled');
	}
}


				menkyoNaiyoSeiGyo();
			});
			// =============
			// 相関処理
			// =============
			// 雇用形態の制御
			function koyoKeitai(){
				// 正社員
				if ($("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '1'
					 || $("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '4') {
					$('#ID_koyoKeitaiRadioBtn1').prop('disabled', true);
				} else {
					$('#ID_koyoKeitaiRadioBtn1').prop('disabled', false);
				}
				// 正社員以外
				if ($("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '1'
					 || $("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '4') {
					$('#ID_koyoKeitaiRadioBtn2').prop('disabled', true);
				} else {
					$('#ID_koyoKeitaiRadioBtn2').prop('disabled', false);
				}
				// 有期雇用派遣労働者
				if ($("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '2'
					 || $("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '3') {
					$('#ID_koyoKeitaiRadioBtn3').prop('disabled', true);
				} else {
					$('#ID_koyoKeitaiRadioBtn3').prop('disabled', false);
				}
				// 無期雇用派遣労働者
				if ($("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '2'
					 || $("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '3'
					 || $("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '4') {
					$('#ID_koyoKeitaiRadioBtn4').prop('disabled', true);
				} else {
					$('#ID_koyoKeitaiRadioBtn4').prop('disabled', false);
				}
				// パート労働者
				if ($("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '1') {
					$('#ID_koyoKeitaiPartRadioBtn1').prop('disabled', true);
				} else {
					$('#ID_koyoKeitaiPartRadioBtn1').prop('disabled', false);
				}
				// 有期雇用派遣パート
				if ($("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '2'
					 || $("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '3') {
					$('#ID_koyoKeitaiPartRadioBtn2').prop('disabled', true);
				} else {
					$('#ID_koyoKeitaiPartRadioBtn2').prop('disabled', false);
				}
				// 無期雇用派遣パート
				if ($("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '2'
					 || $("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '3'
					 || $("input:radio[name='sHGKeitaiRadioBtn']:checked").val() == '4') {
					$('#ID_koyoKeitaiPartRadioBtn3').prop('disabled', true);
				} else {
					$('#ID_koyoKeitaiPartRadioBtn3').prop('disabled', false);
				}
			}
			// 正社員以外の名称制御
			function sSINIgaiMeisyo() {
				// 正社員以外が選択されている場合
				if ($("input:radio[name='koyoKeitaiRadioBtn']:checked").val() == '2') {
					$('#ID_sSINIgaiMeisyo').prop('disabled', false);
					$('#ID_sSINIgaiMeisyoSTU').prop('disabled', false);
				// 正社員以外が選択されていない場合
				} else {
					$('#ID_sSINIgaiMeisyo').prop('disabled', true);
					$('#ID_sSINIgaiMeisyoSTU').prop('disabled', true);
				}
			}
			// 正社員登用の有無制御
			function sSINToyoRadioBtn() {
				// 正社員以外,有期雇用派遣労働者,無期雇用派遣労働者,パート労働者,有期雇用派遣パート,無期雇用派遣パートが選択されている場合
				if (kjKbn == 'ID_2') {
					if ($("input:radio[name='koyoKeitaiPartRadioBtn']:checked").val() == '5'
						|| $("input:radio[name='koyoKeitaiPartRadioBtn']:checked").val() == '6'
						|| $("input:radio[name='koyoKeitaiPartRadioBtn']:checked").val() == '7') {
						$('input[name=sSINToyoRadioBtn]').prop('disabled', false);
					} else {
						$('input[name=sSINToyoRadioBtn]').prop('disabled', true);
					}
				} else {
					if ($("input:radio[name='koyoKeitaiRadioBtn']:checked").val() == '2'
						|| $("input:radio[name='koyoKeitaiRadioBtn']:checked").val() == '3'
						|| $("input:radio[name='koyoKeitaiRadioBtn']:checked").val() == '4') {
						$('input[name=sSINToyoRadioBtn]').prop('disabled', false);
					} else {
						$('input[name=sSINToyoRadioBtn]').prop('disabled', true);
					}
				}
			}
			// 正社員登用の実績制御
			function sSINToyoJisseki() {
				// 正社員登用の有無ありを選択した場合
				if ($("input:radio[name='sSINToyoRadioBtn']:checked").val() == '1') {
					// 正社員登用の有無が非活性の場合
					if ($('input[name=sSINToyoRadioBtn]').prop('disabled')) {
						$('#ID_sSINToyoJisseki').prop('disabled', true);
					} else {
						$('#ID_sSINToyoJisseki').prop('disabled', false);
					}
				} else {
					$('#ID_sSINToyoJisseki').prop('disabled', true);
				}
			}
			// 雇用期間制御
			function koyoKikanRadioBtn() {
				// ""(空文字)または、雇用期間の定めなしを選択した場合
				if (($('#ID_koyoKikanSadameUmuCmbBox').val() == '') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '1')) {
					$('input[name=koyoKikanRadioBtn]').prop('disabled', true);

					// 雇用期間の定めあり（4 ヶ月以上）または雇用期間の定めあり（4 ヶ月未満）または日雇（日々雇用または1 ヶ月未満）を選択した場合
				} else if (($('#ID_koyoKikanSadameUmuCmbBox').val() == '2') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '3') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '4')) {
					$('input[name=koyoKikanRadioBtn]').prop('disabled', false);
				}
			}
			// 雇用期間年月日制御
			function koyoKikanYMD() {
				// ""(空文字)または、雇用期間の定めなしを選択した場合
				if (($('#ID_koyoKikanSadameUmuCmbBox').val() == '') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '1')) {
					$('#ID_koyoSTANenYY').prop('disabled', true);
					$('#ID_koyoSTANenMM').prop('disabled', true);
					$('#ID_koyoSTANenDD').prop('disabled', true);
					$('#ID_koyoENDNenYY').prop('disabled', true);
					$('#ID_koyoENDNenMM').prop('disabled', true);
					$('#ID_koyoENDNenDD').prop('disabled', true);

					// 雇用期間の定めあり（4 ヶ月以上）または雇用期間の定めあり（4 ヶ月未満）または日雇（日々雇用または1 ヶ月未満）を選択した場合
				} else if (($('#ID_koyoKikanSadameUmuCmbBox').val() == '2') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '3') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '4')) {
					// 期間を選択が選択されている場合
					if ($("input:radio[name='koyoKikanRadioBtn']:checked").val() == '1') {
						$('#ID_koyoSTANenYY').prop('disabled', false);
						$('#ID_koyoSTANenMM').prop('disabled', false);
						$('#ID_koyoSTANenDD').prop('disabled', false);
						$('#ID_koyoENDNenYY').prop('disabled', false);
						$('#ID_koyoENDNenMM').prop('disabled', false);
						$('#ID_koyoENDNenDD').prop('disabled', false);

						// 年月数で入力が選択されている場合
					} else if ($("input:radio[name='koyoKikanRadioBtn']:checked").val() == '2') {
						$('#ID_koyoSTANenYY').prop('disabled', true);
						$('#ID_koyoSTANenMM').prop('disabled', true);
						$('#ID_koyoSTANenDD').prop('disabled', true);
						$('#ID_koyoENDNenYY').prop('disabled', true);
						$('#ID_koyoENDNenMM').prop('disabled', true);
						$('#ID_koyoENDNenDD').prop('disabled', true);

						// 未選択の場合
					} else {
						$('#ID_koyoSTANenYY').prop('disabled', true);
						$('#ID_koyoSTANenMM').prop('disabled', true);
						$('#ID_koyoSTANenDD').prop('disabled', true);
						$('#ID_koyoENDNenYY').prop('disabled', true);
						$('#ID_koyoENDNenMM').prop('disabled', true);
						$('#ID_koyoENDNenDD').prop('disabled', true);
					}
				}
			}
			// 雇用期間年月数制御
			function koyoKikan() {
				// ""(空文字)または、雇用期間の定めなしを選択した場合
				if (($('#ID_koyoKikanSadameUmuCmbBox').val() == '') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '1')) {
					$('#ID_koyoKikanNen').prop('disabled', true);
					$('#ID_koyoKikanKagetu').prop('disabled', true);

					// 雇用期間の定めあり（4 ヶ月以上）または雇用期間の定めあり（4 ヶ月未満）または日雇（日々雇用または1 ヶ月未満）を選択した場合
				} else if (($('#ID_koyoKikanSadameUmuCmbBox').val() == '2') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '3') || ($('#ID_koyoKikanSadameUmuCmbBox').val() == '4')) {

					// 期間を選択が選択されている場合
					if ($("input:radio[name='koyoKikanRadioBtn']:checked").val() == '1') {
						$('#ID_koyoKikanNen').prop('disabled', true);
						$('#ID_koyoKikanKagetu').prop('disabled', true);

						// 年月数で入力が選択されている場合
					} else if ($("input:radio[name='koyoKikanRadioBtn']:checked").val() == '2') {
						$('#ID_koyoKikanNen').prop('disabled', false);

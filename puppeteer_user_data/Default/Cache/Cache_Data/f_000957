			// 雇用期間
			$('input[name=koyoKikanRadioBtn]').click(function() {
				// 雇用期間年月日制御を呼び出す
				koyoKikanYMD();
				// 雇用期間年月数制御を呼び出す
				koyoKikan();
				// 契約更新の可能性の有無制御を呼び出す
				keiyakuKSNKNSIUmuRadioBtn();
				// 契約更新の可能性あり制御を呼び出す
				keiyakuKSNRadioBtn();
				// 契約更新の条件制御を呼び出す
				keiyakuKSNJKN();
			});
			// 契約更新の可能性有無
			$('input[name=keiyakuKSNKNSIUmuRadioBtn]').click(function() {
				// 契約更新の可能性あり制御を呼び出す
				keiyakuKSNRadioBtn();
				// 契約更新の条件制御を呼び出す
				keiyakuKSNJKN();

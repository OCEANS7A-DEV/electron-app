				omune();
			});
			// 必要な経験詳細（一般）
			$('input[name=hYNAKIKNTRadioBtn]').click(function() {
				// 必要な経験詳細制御（一般）を呼び出す
				hYNAKIKNSHSI();
			});

			// 必要な経験詳細（高卒）
			$('input[name=hYNAKIKNTRadioBtnHS]').click(function() {

window.onload = function(){
	
	//画面に戻ってきた時の説明会の数の保持
	for (i=1;i<=5;i++){
		$('#ID_sHKIKiboATS_'+i).find('input.button').attr({"name":"atsSelect"+i,"id":"ID_atsSelect"+i});
	}
	//画面に戻ってきた時の紹介希望安定所の数の保持
	var addnum = $('#ID_sHKIKiboATSnum').val();
	if(addnum == 5){
		nodisp($('#ID_sHKIKiboATSbtnArea_1'));
	}
	
	// 帳票出力前の入力チェックにてエラーが発生していない場合
	if($('#ID_preCheckFlg').val() == 'false'){
		// 仮求人票を新規Windowで表示
		var form = $('#ID_kyujinhyoBtn').closest('form');
		$('#ID_action').val('kyujinhyoBtn');
		form.closest('form').attr('target', '_blank');
		$('#ID_tokenNoReset').val('1');
		form.closest('form').submit();
		
		// アクションをリセットして、新規Windowでのサブミットを無効化
		$('#ID_tokenNoReset').val('0');
		$('#ID_preCheckFlg').val('true');
		$('#ID_action').val('');
		form.closest('form').attr('target', '_self');
	}
}


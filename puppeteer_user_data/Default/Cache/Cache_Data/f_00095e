// 数値をカンマ編集
function toCommaNum(num){
	return String(num).replace( /(\d)(?=(\d\d\d)+(?!\d))/g, '$1,');
}
// 求人連絡数を計算
function calcKjRenrakuNum(){
	var num = 0;
	var tmp;
	// 各項目の合計値を算出
	$('tr.shokai_kibo_ats').find('[id^="ID_kJRRSUInput"]').each(function(i, e){
		tmp = $(this).val();
		if(Math.round(tmp) == tmp && tmp >= 0 & new RegExp(/^\d{1,}$/).test(tmp)) {
			// 数値チェックOKの場合のみ加算
			num = num + Number(tmp);
		}
	});
	// 算出結果を設定
	// hidden
	$('#ID_kJRRSUSosuHyoji').val(toCommaNum(num));
	// ラベル
	$('#ID_kJRRSUSosuHyojiLabel').children('div:first').html(toCommaNum(num));
}

// 紹介希望安定所数を計算
function calcShkKiboAtsNum(){
	var num = 0;
	var tmp;
	// 各項目の有効入力数を算出
	$('tr.shokai_kibo_ats').find('[id^="ID_atsCode"]').each(function(i, e){
		tmp = $(this).val();
		if(tmp.trim() !== ''){
			num = num + 1;
		}
	});
	// 算出結果を設定
	// hidden
	$('#ID_aTSSosuHyoji').val(toCommaNum(num));
	// ラベル
	$('#ID_aTSSosuHyojiLabel').children('div:first').html(toCommaNum(num));

}
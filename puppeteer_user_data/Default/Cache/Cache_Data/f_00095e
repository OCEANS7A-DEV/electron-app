//追加削除
$(function(){
	// 入力欄を追加ボタンが押された時のアクション
	$("table").on('click','[name^="sMKIkaisaiadd"]' ,function() {
		// 説明会開催有無が「あり」で選択した場合、説明会情報を画面に追加する
		if($('#ID_sMKIKaisaiRadioBtn1').is(':checked')){
			// 画面のHTML内容より繰り返内容の最後のIDを取得する
			var id = sMKIkaisaiCount();
			// 追加上限
			if(id < 3){
				// 現在繰り返し数（隠し項目）の値をカウントする
				var sMKIkaisainum = document.getElementById('ID_sMKIkaisaiHidden').value;
				// カウントする
				sMKIkaisainum = parseInt(sMKIkaisainum) + 1;
				$('[id^="ID_sMKIkaisaiHidden"]').val(sMKIkaisainum);
				// 繰り返す情報を画面に追加する
				sMKIkaisaiAdd(id);
				
				sessionKeep();
			}
		}
	});

	// 削除ボタンが押された時のアクション
	$("table").on('click','[name^="sMKIkaisaidel"]' ,function() {
		// 説明会開催有無が「あり」で選択した場合、説明会情報を画面に追加する
		if($('#ID_sMKIKaisaiRadioBtn1').is(':checked')){
			// 画面のHTML内容より繰り返し内容の最後のIDを取得する
			var id = sMKIkaisaiCount();
			if(id > 1){
				// 現在繰り返し数（隠し項目）の値をマイナスする
				var sMKIkaisainum = document.getElementById('ID_sMKIkaisaiHidden').value;
				sMKIkaisainum = parseInt(sMKIkaisainum) - 1;
				$('[id^="ID_sMKIkaisaiHidden"]').val(sMKIkaisainum);
				
				// 削除対象の繰り返すIDを取得する
				var target = $(this).attr('id').lastIndexOf('_', $(this).attr('id').length);
				// 該当繰り返す情報を画面に削除する
				sMKIkaisaiDel(parseInt($(this).attr('id').substr(target + 1, 2)));
				
				sessionKeep();
			}
		}
	});
});

//説明会を増やすメソッド
function sMKIkaisaiAdd(id){
	// 画面最後の繰り返し情報をコピーする
	var mainDivnew = $('#ID_sMKIkaisai_' + id).clone(true);
	// 一番外側のDivのIDを変更する
	mainDivnew.attr("id", "ID_sMKIkaisai_"+(id+1));
	//	見出し項目を変更する
	mainDivnew.find('[name^="sMKIkaisaiTitle"]').attr({"name":"sMKIkaisaiTitle"+(id+1),"id":"ID_tsMKIkaisaiTitle"+(id+1)});
	mainDivnew.find('[name^="sMKIkaisaiTitle"]').html("説明会"+(id+1));
	mainDivnew.find('[name^="sMKIkaisaiNichijiTitle"]').attr({"name":"sMKIkaisaiNichijiTitle"+(id+1),"id":"ID_sMKIkaisaiNichijiTitle"+(id+1)});
	mainDivnew.find('[name^="sMKIkaisaiSub"]').attr({"name":"sMKIkaisaiSub"+(id+1),"id":"ID_sMKIkaisaiSub"+(id+1)});
	// 削除ボタンのIDとNAMEを変更する
	mainDivnew.find('[name^="sMKIkaisaidel_"]').attr({"name":"sMKIkaisaidel_"+(id+1),"id":"ID_sMKIkaisaidel_"+(id+1)});
	// 場所項目のIDとNAMEを変更する
	mainDivnew.find('[name^="smkiKaisaiBS"]').attr({"name":"smkiKaisaiBS"+(id+1),"id":"ID_smkiKaisaiBS"+(id+1)}).val("");
	// 日付項目のIDとNAMEを変更する
	mainDivnew.find('[name^="kaisaiNen'+id+'YY"]').attr({"name":"kaisaiNen"+(id+1)+"YY","id":"ID_kaisaiNen"+(id+1)+"YY"}).val("");
	mainDivnew.find('[name^="kaisaiNen'+id+'MM"]').attr({"name":"kaisaiNen"+(id+1)+"MM","id":"ID_kaisaiNen"+(id+1)+"MM"}).val("");
	mainDivnew.find('[name^="kaisaiNen'+id+'DD"]').attr({"name":"kaisaiNen"+(id+1)+"DD","id":"ID_kaisaiNen"+(id+1)+"DD"}).val("");
	// 時刻項目のIDとNAMEを変更する
	mainDivnew.find('[name^="kaisaiJNJiCmbBoxHH'+id+'HH"]').attr({"name":"kaisaiJNJiCmbBoxHH"+(id+1)+"HH","id":"ID_kaisaiJNJiCmbBoxHH"+(id+1)+"HH"}).val("");
	mainDivnew.find('[name^="kaisaiJNJiCmbBoxHH'+id+'MM"]').attr({"name":"kaisaiJNJiCmbBoxHH"+(id+1)+"MM","id":"ID_kaisaiJNJiCmbBoxHH"+(id+1)+"MM"}).val("");
	
	// 入力支援ボタン「カレンダー」の初期化
	mainDivnew.find('[id^="dp"]').each(function(i){
		var cntTmp = $(this).attr('id').slice(-1);
		cntTmp = Number(cntTmp) + 1;
		$(this).attr('id',$(this).attr('id').slice(0, -1) + cntTmp);
	});
	mainDivnew.find('.button.calendar.ui-datepicker-trigger').remove(); 
	// コピーした内容を画面に追加
	$('#ID_sMKIkaisai_'+id).after(mainDivnew);
	reInitDatePicker();
	// 現在の件数より追加ボタンを表示／非表示にする
	if(id < 2){
		disp($('#ID_sMKIkaisaibtnArea_1'));
	}else{
		nodisp($('#ID_sMKIkaisaibtnArea_1'));
	}
	// 削除ボタンを表示にする
	disp($('#ID_sMKIkaisaidel_1'));
	disp($('#ID_sMKIkaisaidel_2'));
	disp($('#ID_sMKIkaisaidel_3'));
}

//説明会を減らすメソッド
function sMKIkaisaiDel(id){
	var num = sMKIkaisaiCount();
	// 削除対象の繰り返す情報を削除する
	$('#ID_sMKIkaisai_' + id).remove();
	// 削除対象後の繰り返す情報をリネームする
	for(var i = id+1; i<= num; i++){
		// // 一番外側のDivのIDを変更する
		$('#ID_sMKIkaisai_'+i).attr('id','ID_sMKIkaisai_'+(i-1));
		// 見出し項目を変更する
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="sMKIkaisaiTitle"]').attr({"name":"sMKIkaisaiTitle"+(i-1),"id":"ID_tsMKIkaisaiTitle"+(i-1)});
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="sMKIkaisaiTitle"]').html("説明会"+(i-1));
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="sMKIkaisaiNichijiTitle"]').attr({"name":"sMKIkaisaiNichijiTitle"+(i-1),"id":"ID_sMKIkaisaiNichijiTitle"+(id+1)});
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="sMKIkaisaiSub"]').attr({"name":"sMKIkaisaiSub"+(i-1),"id":"ID_sMKIkaisaiSub"+(i-1)});
		// 場所項目のIDとNAMEを変更する
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="smkiKaisaiBS"]').attr({"name":"smkiKaisaiBS"+(i-1),"id":"ID_smkiKaisaiBS"+(i-1)});
		// 削除ボタンのIDとNAMEを変更する
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="sMKIkaisaidel_"]').attr({"name":"sMKIkaisaidel_"+(i-1),"id":"ID_sMKIkaisaidel_"+(i-1)});
		// 日付項目のIDとNAMEを変更する
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="kaisaiNen'+(i)+'YY"]').attr({"name":"kaisaiNen"+(i-1)+"YY","id":"ID_kaisaiNen"+(i-1)+"YY"});
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="kaisaiNen'+(i)+'MM"]').attr({"name":"kaisaiNen"+(i-1)+"MM","id":"ID_kaisaiNen"+(i-1)+"MM"});
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="kaisaiNen'+(i)+'DD"]').attr({"name":"kaisaiNen"+(i-1)+"DD","id":"ID_kaisaiNen"+(i-1)+"DD"});
		// 時刻項目のIDとNAMEを変更する
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="kaisaiJNJiCmbBoxHH'+(i)+'HH"]').attr({"name":"kaisaiJNJiCmbBoxHH"+(i-1)+"HH","id":"ID_kaisaiJNJiCmbBoxHH"+(i-1)+"HH"});
		$('#ID_sMKIkaisai_'+(i-1)).find('[name^="kaisaiJNJiCmbBoxHH'+(i)+'MM"]').attr({"name":"kaisaiJNJiCmbBoxHH"+(i-1)+"MM","id":"ID_kaisaiJNJiCmbBoxHH"+(i-1)+"MM"});
	}
	// 現在の件数より追加ボタンを表示／非表示にする
	if(i > 1){
		disp($('#ID_sMKIkaisaibtnArea_1'));
	}else{
		nodisp($('#ID_sMKIkaisaibtnArea_1'));
	}

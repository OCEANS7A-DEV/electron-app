}

// ブラウザ情報取得
function getBrowserInfo() {
  const ua = navigator.userAgent;

  const isFirefox = ua.includes("Firefox");
  let firefoxVersion = null;

  if (isFirefox) {
    const match = ua.match(/Firefox\/(\d+)/);
    if (match && match[1]) {
      firefoxVersion = parseInt(match[1], 10);
    }
  }

  return {
    isFirefox,
    firefoxVersion
  };
}



//tableCss対応
function supportFirefoxTableCss() {
	var browser = getBrowserInfo();

	if (!(browser.isFirefox && browser.firefoxVersion < 121)) return;

	// div.m03, div.m03:nth-child(1)
	const targets = [
		'table.normal tr td > div.m03',
		'table.normal tr td > div.flex.input:nth-child(1) > div.m03:nth-child(1)'
	];

	targets.forEach(selector => {
		document.querySelectorAll(selector).forEach(div => {
			if (!div) return;

			if (
				div.querySelector('input[type="text"]') ||
				div.querySelector('input[type="password"]') ||
				div.querySelector('textarea') ||
				div.querySelector('select')
			) {
				div.classList.add('firefox-has-div-m03');
			}
		});
	});

	document.querySelectorAll('table.normal tr').forEach(tr => {
		if (!tr) return;

		const hasTD = tr.querySelectorAll('td');
		if (hasTD.length === 0 || !hasTD) return;

		// has(td) th.r08Th > div
		tr.classList.add('firefox-has-td');

		// not(:has(td)) th
		if (!hasTD) {
			tr.querySelectorAll('th').forEach(th => {
				th.classList.add('firefox-not-has-td-th');
			});
		}

		// has(td) th.r08Th > div
		tr.querySelectorAll('th.r08Th > div').forEach(div => {
			div.classList.add('firefox-div-has-td');
		});

		const hasExcluded = tr.querySelector('td.media_nodisp, td.nes2') !== null;
		if (hasExcluded) {
			// has(td):has(td.media_nodisp, td.nes2) th
			tr.classList.add('firefox-th-has-excluded');
		} else {
			// has(td):not(:has(td.media_nodisp, td.nes2)) th
			tr.classList.add('firefox-th-no-excluded');
		}
	});

	// table.list_table_colored
	document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
		if (!checkbox) return;

		let chkId = checkbox.id;

		checkbox.addEventListener('change', function(e){
			if (chkId == "ID_allSlctCKBox0") updateTableAllCheckedState();
			else updateTableCheckedState(checkbox);
		});

		if (checkbox.checked) {
			checkbox.closest('tr').classList.add('firefox-has-checkbox-checked');
		}
	});

	// function
	// table.list_table_colored all checked
	function updateTableAllCheckedState() {

		const table =  document.querySelectorAll('table.list_table_colored tr');

		if (!table) return;

		var allSelectChk = table[0].children[0].children[0].children[0].children[0].checked;

		for (var i=1; i<table.length; i++) {
			var chkbox = table[i].children[0].children[0]
			if (allSelectChk) {
				if (chkbox !== undefined) {
					table[i].classList.add('firefox-has-checkbox-checked');
				}
			} else {
				table[i].classList.remove('firefox-has-checkbox-checked');
			}
		}
	}

	// table.list_table_colored
	function updateTableCheckedState(checkbox) {
		const table = checkbox.closest('table.list_table_colored tr');

		if (!table) return;

		if (checkbox.checked) {
			table.classList.add('firefox-has-checkbox-checked');
		} else {
			table.classList.remove('firefox-has-checkbox-checked');
		}
	}

}

//navbarCss対応
function supportFirefoxNavbarCss() {
	var browser = getBrowserInfo();

	if (!(browser.isFirefox && browser.firefoxVersion < 121)) return;

	// body hamburger check
	document.querySelectorAll('div.navigation_menu input[type="checkbox"]').forEach(checkbox => {

	}

	adjustHeader();

});

/*
 * ヘッダ固定関数
 */
function fixHeader(scrollTop){
	var nav = $('#top_header');
	if(scrollTop > 0){
		nav.addClass('is_fixed');
	} else {
		nav.removeClass('is_fixed');
	}
}
